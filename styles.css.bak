:root{--dark-blue:#003B5C;--gold:#FFB81C;--white:#FFFFFF;--page-background:#F5F5F5;--dark-text:#222;--muted-text:#555;--max-width:1180px;--radius:10px;--shadow:0 2px 8px rgba(0,0,0,.12);--shadow-hover:0 8px 22px rgba(0,0,0,.20);--transition:160ms ease}
*,*::before,*::after{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--page-background);color:var(--dark-text);font-size:16px;line-height:1.6}a{color:inherit}
.skip-link{position:absolute;top:-100px;left:20px;z-index:99999;padding:12px 18px;background:#003B5C;color:#fff;border:3px solid #FFB81C;border-radius:0 0 6px 6px;font-weight:700;text-decoration:none}.skip-link:focus{top:0}:focus-visible{outline:4px solid #FFB81C;outline-offset:4px}
.site-header{background:#003B5C;color:#fff}.header-inner{width:min(calc(100% - 48px),var(--max-width));min-height:82px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:30px}.site-brand{display:inline-flex;align-items:center;gap:14px;color:#fff;text-decoration:none}.site-brand-mark{display:grid;place-items:center;min-width:62px;min-height:44px;padding:7px 10px;background:#FFB81C;color:#003B5C;border-radius:4px;font-weight:900;font-size:.95rem}.site-brand-text{display:flex;flex-direction:column;font-weight:800;font-size:1.15rem;line-height:1.15}.site-brand-text small{margin-top:4px;font-size:.76rem;font-weight:400;color:#fff}
.primary-nav ul{display:flex;align-items:center;flex-wrap:wrap;gap:5px;margin:0;padding:0;list-style:none}.primary-nav a{display:block;padding:9px 12px;color:#fff;font-size:.94rem;font-weight:700;text-decoration:none;border-radius:6px}.primary-nav a:hover{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:4px}
.hero{background:#fff}.hero-inner{width:min(calc(100% - 48px),var(--max-width));margin:0 auto;padding:64px 0 58px}.eyebrow{display:inline-block;margin-bottom:16px;padding:5px 11px;background:#FFB81C;color:#003B5C;border-radius:999px;font-size:.76rem;font-weight:900;letter-spacing:.07em;text-transform:uppercase}.hero h1{max-width:850px;margin:0;color:#003B5C;font-size:clamp(2.35rem,6vw,4.4rem);line-height:1.05;letter-spacing:-.04em}.hero p{max-width:750px;margin:22px 0 0;color:#555;font-size:1.14rem;line-height:1.7}
main{width:min(calc(100% - 48px),var(--max-width));margin:0 auto;padding:52px 0 80px}.content-section{margin-bottom:60px}.content-section:last-child{margin-bottom:0}.section-heading{margin-bottom:24px}.section-heading h2{margin:0;color:#003B5C;font-size:2rem;line-height:1.2}.section-heading p{max-width:760px;margin:10px 0 0;color:#555;font-size:1rem}
.card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.resource-card,.feature-card,.quick-link,.support-banner{background-color:#003B5C;color:#fff}.resource-card{display:flex;flex-direction:column;min-height:190px;padding:24px;border:2px solid #003B5C;border-top:5px solid #FFB81C;border-radius:10px;text-decoration:none;box-shadow:var(--shadow);transition:transform var(--transition),box-shadow var(--transition),border-color var(--transition)}.resource-card:hover,.feature-card:hover,.quick-link:hover{background-color:#003B5C;color:#fff;border-color:#FFB81C;transform:translateY(-3px);box-shadow:var(--shadow-hover)}.resource-card:focus-visible,.feature-card:focus-visible,.quick-link:focus-visible{background-color:#003B5C;color:#fff;outline:4px solid #FFB81C;outline-offset:5px;border-color:#FFB81C}.card-icon{display:grid;place-items:center;width:42px;height:42px;margin-bottom:17px;background:#FFB81C;color:#003B5C;border-radius:7px;font-size:1.15rem;font-weight:900;line-height:1}.resource-card h3{margin:0;color:#fff !important;font-size:1.18rem;line-height:1.3}.resource-card p{margin:9px 0 0;color:#fff !important;font-size:.94rem;line-height:1.55}
.feature-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.feature-card{display:flex;flex-direction:column;min-height:215px;padding:28px;border:2px solid #003B5C;border-top:5px solid #FFB81C;border-radius:10px;text-decoration:none;box-shadow:var(--shadow);transition:transform var(--transition),box-shadow var(--transition),border-color var(--transition)}.feature-label{display:inline-block;align-self:flex-start;margin-bottom:17px;padding:4px 9px;background:#FFB81C;color:#003B5C;border-radius:999px;font-size:.72rem;font-weight:900;letter-spacing:.05em;text-transform:uppercase}.feature-card h3{margin:0;color:#fff !important;font-size:1.45rem;line-height:1.25}.feature-card p{max-width:650px;margin:11px 0 0;color:#fff !important;font-size:.97rem;line-height:1.6}
.quick-links{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.quick-link{display:block;min-height:72px;padding:17px 18px;border:2px solid #003B5C;border-left:5px solid #FFB81C;border-radius:10px;font-size:.94rem;font-weight:750;text-decoration:none;box-shadow:var(--shadow);transition:transform var(--transition),box-shadow var(--transition),border-color var(--transition)}
.support-banner{display:flex;align-items:center;justify-content:space-between;gap:30px;padding:30px;border-top:5px solid #FFB81C;border-radius:10px;box-shadow:var(--shadow)}.support-banner-text{max-width:700px}.support-banner h2{margin:0;color:#fff;font-size:1.5rem;line-height:1.25}.support-banner p{margin:10px 0 0;color:#fff;font-size:.96rem}.support-button{display:inline-block;flex:0 0 auto;padding:12px 18px;background:#FFB81C;color:#003B5C;border:3px solid #FFB81C;border-radius:6px;font-weight:900;text-decoration:none}.support-button:hover{background:#fff;color:#003B5C}
.page-hero{background:#003B5C;color:#fff}.page-hero-inner{width:min(calc(100% - 48px),var(--max-width));margin:0 auto;padding:42px 0}.page-hero .eyebrow{margin-bottom:12px}.page-hero h1{max-width:850px;margin:0;color:#fff;font-size:clamp(2rem,4vw,3.4rem);line-height:1.1}.page-hero p{max-width:760px;margin:12px 0 0;color:#fff;font-size:1.05rem}
.breadcrumbs{margin-bottom:22px;font-size:.9rem;color:#fff}.breadcrumbs a{color:#fff;text-underline-offset:3px}.topic-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px}.topic-card{display:flex;flex-direction:column;min-height:175px;padding:20px;background:#003B5C;color:#fff;border:2px solid #003B5C;border-top:5px solid #FFB81C;border-radius:10px;text-decoration:none;box-shadow:var(--shadow);transition:transform var(--transition),box-shadow var(--transition),border-color var(--transition)}.topic-card:hover{background:#003B5C;color:#fff;border-color:#FFB81C;transform:translateY(-3px);box-shadow:var(--shadow-hover)}.topic-card:focus-visible{background:#003B5C;color:#fff;outline:4px solid #FFB81C;outline-offset:5px;border-color:#FFB81C}.topic-card h3{margin:0;color:#fff;font-size:1.05rem;line-height:1.3}.topic-card p{margin:9px 0 0;color:#fff;font-size:.88rem;line-height:1.5}.topic-card .card-icon{margin-bottom:14px}
.prose{max-width:820px}.prose p{margin:0 0 18px}.callout{margin-top:28px;padding:22px;background:#fff;border-left:5px solid #FFB81C;border-radius:8px}
.site-footer{background:#003B5C;color:#fff;border-top:5px solid #FFB81C}.footer-inner{width:min(calc(100% - 48px),var(--max-width));margin:0 auto;padding:35px 0;display:flex;align-items:center;justify-content:space-between;gap:30px}.footer-inner p{margin:0;color:#fff;font-size:.9rem}.footer-nav ul{display:flex;flex-wrap:wrap;gap:18px;margin:0;padding:0;list-style:none}.footer-nav a{color:#fff;font-size:.9rem;font-weight:700;text-underline-offset:3px}
@media(max-width:1100px){.topic-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:900px){.header-inner{padding:18px 0;align-items:flex-start;flex-direction:column;gap:14px}.card-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.quick-links{grid-template-columns:repeat(2,minmax(0,1fr))}.support-banner{align-items:flex-start;flex-direction:column}.topic-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.header-inner,.hero-inner,main,.footer-inner,.page-hero-inner{width:min(calc(100% - 32px),var(--max-width))}.hero-inner{padding:46px 0 44px}main{padding:42px 0 60px}.card-grid,.feature-grid,.quick-links,.topic-grid{grid-template-columns:1fr}.resource-card{min-height:180px}.feature-card{min-height:195px}.footer-inner{align-items:flex-start;flex-direction:column}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important;animation:none!important}.resource-card:hover,.feature-card:hover,.quick-link:hover,.topic-card:hover{transform:none}}
@media(forced-colors:active){.resource-card,.feature-card,.quick-link,.support-banner,.topic-card{border:2px solid CanvasText}.card-icon,.feature-label,.support-button{border:2px solid CanvasText}}

/* Training options */
.training-options{background:#fff}.training-options-inner{width:min(calc(100% - 48px),var(--max-width));margin:0 auto;padding:36px 0}.training-options h2{margin:0 0 18px;color:#003B5C;font-size:1.75rem;line-height:1.2}.training-options-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.training-option-card{display:flex;align-items:center;min-height:110px;padding:24px;background:#003B5C;color:#fff;border:2px solid #003B5C;border-top:5px solid #FFB81C;border-radius:10px;text-decoration:none;box-shadow:var(--shadow);transition:transform var(--transition),box-shadow var(--transition),border-color var(--transition)}.training-option-card h3{margin:0;color:#fff;font-size:1.2rem;line-height:1.3}.training-option-card:hover{background:#003B5C;color:#fff;border-color:#FFB81C;transform:translateY(-3px);box-shadow:var(--shadow-hover)}.training-option-card:focus-visible{background:#003B5C;color:#fff;outline:4px solid #FFB81C;outline-offset:5px;border-color:#FFB81C}@media(max-width:650px){.training-options-inner{width:min(calc(100% - 32px),var(--max-width));padding:28px 0}.training-options-grid{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){.training-option-card:hover{transform:none}}
